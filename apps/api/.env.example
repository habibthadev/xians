# File limits
MAX_FILE_SIZE_MB=100
MAX_BATCH_SIZE_MB=500
MAX_FILES_PER_BATCH=20
DEFAULT_TTL_HOURS=168

# Database
DATABASE_URL=postgres://user:password@localhost:5432/xians?sslmode=disable

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xians
R2_PUBLIC_HOSTNAME=

# Auth
JWT_SIGNING_SECRET=change-this-to-a-random-32-char-string

# CORS
ALLOWED_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_INIT_PER_MIN=10
RATE_LIMIT_UNLOCK_PER_MIN=5
RATE_LIMIT_REPORT_PER_HOUR=3

# Server
PORT=8080

# Production - set via flyctl secrets:
# flyctl secrets set DATABASE_URL="..."
# flyctl secrets set R2_ACCOUNT_ID="..."
# flyctl secrets set R2_ACCESS_KEY_ID="..."
# flyctl secrets set R2_SECRET_ACCESS_KEY="..."
# flyctl secrets set R2_BUCKET_NAME="..."
# flyctl secrets set R2_PUBLIC_HOSTNAME="..."
# flyctl secrets set JWT_SIGNING_SECRET="..."
